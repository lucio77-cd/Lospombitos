{
  "name": "los-pombitos-api",
  "private": true,
  "version": "1.0.0",
  "description": "Funções serverless e testes de segurança do Los Pombitos.",
  "scripts": {
    "test": "node --test tests/carteiraInicial.test.js tests/inicializarCarteiraService.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-los-pombitos \"node --test tests/firestore.rules.test.js\"",
    "test:all": "npm test && npm run test:rules"
  },
  "dependencies": {
    "firebase-admin": "^12.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.2",
    "firebase-tools": "^13.29.2"
  }
}
